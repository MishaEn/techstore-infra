### Переменные окружения
# Мы используем порт 8080, так как ты пробрасываешь Kong через kubectl port-forward
@host = http://localhost:8080
@contentType = application/json
@email = phpstorm-test@example.com
@password = password

### 1. Health Check (Проверка жизни сервиса)
# Публичный маршрут, проверяет, что Go-сервис отвечает
GET {{host}}/healthz

### 2. Регистрация нового пользователя
# Публичный маршрут (Kong пропускает без токена)
POST {{host}}/api/v1/users/register
Content-Type: {{contentType}}

{
  "email": "{{email}}",
  "password": "{{password}}",
  "full_name": "PhpStorm User"
}

### 3. Логин (Получение JWT токена)
# Публичный маршрут.
# ВАЖНО: После нажатия "Run", скопируйте access_token из ответа
# и вставьте его в переменную @token ниже.
POST {{host}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    // Небольшой скрипт для PhpStorm: автоматически берет токен из ответа
    // и сохраняет его в глобальную переменную клиента
    client.global.set("auth_token", response.body.access_token);
%}

